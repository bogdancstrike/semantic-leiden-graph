# ---------------------------------------------------------------- images
ES_VERSION=9.5.1
QDRANT_VERSION=v1.19.1
NEO4J_VERSION=2026.09.0

# ---------------------------------------------------------------- secrets (change them)
ELASTIC_PASSWORD=changeme-elastic
NEO4J_PASSWORD=password123
# When set, POST/DELETE endpoints require the X-API-Key header (UI: Settings > API key)
API_KEY=

# ---------------------------------------------------------------- local (non-Docker) execution
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme-elastic
ES_INDEX=documents
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_vectors
QDRANT_PREFER_GRPC=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j

# ---------------------------------------------------------------- model & graph policy
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=64
NEIGHBOR_K=12
MIN_SIMILARITY=0.58
LEIDEN_GAMMA=1.0
LEIDEN_RANDOM_SEED=42
# Smallest Leiden group that counts as a community (>= 2); smaller groups -> "no community"
LEIDEN_MIN_COMMUNITY_SIZE=2

# ---------------------------------------------------------------- limits
UPLOAD_MAX_BYTES=1073741824
UPLOAD_MAX_ROWS=10000000
TEXT_MAX_CHARS=20000

# ---------------------------------------------------------------- performance (docs/PERFORMANCE.md)
QDRANT_INDEXING_THRESHOLD_KB=1000
QDRANT_QUANTIZATION=false

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# ---------------------------------------------------------------- seed
SEED_FILE=/app/data/sample.csv
SEED_FORCE=false
